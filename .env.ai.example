# Copy to .env.ai locally. Never commit .env.ai or paste your key into a chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=25
AI_MAX_CALLS=4
AI_REQUESTS_PER_MINUTE=6

# Optional SEPARATE embedding endpoint (not DeepSeek chat).
# Leave empty for explicitly labelled local lexical retrieval.
AI_EMBEDDING_URL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
