# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

# Local development defaults only. Replace all "changethis" values before deployment.
PROJECT_NAME="Industrial DataOps Platform"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app_test
# Optional: override only to attach an existing database volume intentionally.
# DB_VOLUME_NAME=my-existing-database-volume
DB_VOLUME_EXTERNAL=false

# Portable defaults. Host Python commands run from backend/.
# For WSL, set both values to the same mounted data directory if desired.
IMPORT_STORAGE_HOST_DIR=./data/imports
IMPORT_STORAGE_DIR=../data/imports
